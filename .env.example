# Notificações via Telegram (Recomendado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Recomendado para chats/grupos: restringe o recebimento ao seu usuário Telegram.
TELEGRAM_ALLOWED_USER_ID=

# Supervisão externa Cloudflare (opcional até o Worker ser publicado)
WORKHUNTER_HEARTBEAT_URL=
WORKHUNTER_HEARTBEAT_TOKEN=

# Fallback de e-mail quando o Telegram falhar (Resend)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Notificações via Discord (Opcional - caso prefira Webhook)
DISCORD_WEBHOOK_URL=

# Canais de entrega adicionais (desligados até serem configurados)
# A ordem define o fallback: telegram,email,whatsapp
NOTIFICATION_CHANNELS=telegram,email

# WhatsApp Cloud API oficial da Meta. Requer template aprovado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# WPPConnect / WhatsApp Web experimental channel (disabled until configured)
WPPCONNECT_API_URL=http://127.0.0.1:21465
WPPCONNECT_TOKEN=
WPPCONNECT_SESSION=workhunter
WPPCONNECT_RECIPIENT=

# Juiz Semântico LLM configurável
# Provedor padrão: gemini. Alternativa: openrouter.
# Provider principal e fallback operacional.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=openrouter/free
# Limites de proteção por ciclo e por chamada.
LLM_MAX_CALLS_PER_CYCLE=20
# Compatibilidade com instalações antigas:
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# Gemini
GEMINI_API_KEY=

# OpenRouter (fallback operacional ou provider principal)
OPENROUTER_API_KEY=

# Coleta complementar do LinkedIn (opcional; extensão/Playwright local)
LINKEDIN_MAX_ACTIONS_PER_HOUR=12
LINKEDIN_MIN_INTERVAL_SECONDS=120
# Caminho local do perfil persistente; mantenha-o fora do repositório.
LINKEDIN_BROWSER_PROFILE=
