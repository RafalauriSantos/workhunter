{
  "check_interval_minutes": 60,
  "max_cycle_seconds": 220,
  "progression_min_score": 45,
  "linkedin_max_queries": 1,
  "linkedin_max_pages_per_query": 1,
  "linkedin_poll_interval_hours": 6,
  "linkedin_broad_query_probe": {
    "enabled": false,
    "id": "linkedin-profile-broad-v1",
    "query": "desenvolvedor OR developer OR programador OR software"
  },
  "linkedin_detail_enrichment_enabled": true,
  "linkedin_detail_enrichment_limit": 2,
  "monitors": [
    {
      "type": "rss",
      "description": "Exemplo de feed de oportunidades",
      "company": "Example",
      "url": "https://example.com/jobs.rss",
      "keywords": ["desenvolvedor", "developer", "software", "junior"],
      "exclude_keywords": ["senior", "sênior", "lead"]
    }
  ]
}
